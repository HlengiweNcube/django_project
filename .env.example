SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-render-domain.onrender.com
DATABASE_URL=postgresql://postgres:password@localhost:5432/django_final

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Optional: API-based delivery for free-tier hosts that block SMTP ports
# If set, the project will use Resend HTTP API instead of SMTP.
RESEND_API_KEY=your_resend_api_key

SECURE_HSTS_SECONDS=31536000
